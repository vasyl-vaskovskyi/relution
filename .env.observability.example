# Only for the optional observability stack (compose.observability.yml). Copy to .env.observability (git-ignored):
#   cp .env.observability.example .env.observability
# Compose reads it through --env-file for interpolation only, so the value reaches the otel-lgtm container and never
# the app container. Description: docs/operations/configuration.md. Never commit .env.observability.

# Required: Compose refuses to start the stack while it is empty. Grafana admin password. Generate: openssl rand -base64 32
APPSTORE_GRAFANA_ADMIN_PASSWORD=
# LOCAL TESTING only (public value, never on a shared or deployed instance): uncomment to log in as admin/admin.
# The later line overrides the empty one above.
#APPSTORE_GRAFANA_ADMIN_PASSWORD=admin
