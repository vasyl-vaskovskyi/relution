{
  "uid": "appstore-service",
  "title": "App Store service",
  "description": "API traffic, Apple upstream calls, caches, circuit breakers and traces of the appstore service. Description: docs/operations/observability.md#dashboard",
  "tags": ["appstore"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "30s",
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Metrics arrive over OTLP about once a minute, so rates use windows of at least four minutes and a fresh stack needs a minute or two before panels fill. Run `scripts/demo-traffic.sh` to send a small request mix. Application logs are not exported to Loki (ADR-0048): find a trace's log lines with `docker compose logs app | grep <trace id>`. Details: `docs/operations/observability.md`."
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "API",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests by URI and status",
      "description": "Incoming requests per second (http.server.requests). URI templates only, never query strings.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "auto" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (uri, status) (rate(http_server_requests_milliseconds_count{job=\"appstore\"}[$__rate_interval]))",
          "legendFormat": "{{status}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error ratio",
      "description": "Share of requests answered with 4xx and 5xx. 4xx includes expected client errors such as 400, 401 and 404.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(http_server_requests_milliseconds_count{job=\"appstore\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_milliseconds_count{job=\"appstore\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(http_server_requests_milliseconds_count{job=\"appstore\", status=~\"4..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_milliseconds_count{job=\"appstore\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in range by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "colorMode": "none", "graphMode": "none", "orientation": "horizontal" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (round((increase(http_server_requests_milliseconds_count{job=\"appstore\"}[$__range]) and http_server_requests_milliseconds_count{job=\"appstore\"} offset $__range) or (last_over_time(http_server_requests_milliseconds_count{job=\"appstore\"}[$__range]) unless http_server_requests_milliseconds_count{job=\"appstore\"} offset $__range)))",
          "legendFormat": "HTTP {{status}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API latency p50 and p95 (from traces)",
      "description": "Server span latency from Tempo's span metrics. http.server.requests carries no percentile buckets, so percentiles come from the traces (100 % sampling in this stack).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"appstore\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "p95 {{span_name}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"appstore\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "p50 {{span_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API latency mean and max by URI",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (uri) (rate(http_server_requests_milliseconds_sum{job=\"appstore\"}[$__rate_interval])) / sum by (uri) (rate(http_server_requests_milliseconds_count{job=\"appstore\"}[$__rate_interval]))",
          "legendFormat": "mean {{uri}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (uri) (http_server_requests_max_milliseconds{job=\"appstore\"})",
          "legendFormat": "max {{uri}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Apple upstream",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Apple calls by API and outcome",
      "description": "One sample per logical Apple call after retries, or per local short-circuit (appstore.apple.requests).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (api, outcome) (rate(appstore_apple_requests_milliseconds_count{job=\"appstore\"}[$__rate_interval]))",
          "legendFormat": "{{api}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Apple calls in range by API and outcome",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "continuous-BlPu" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (api, outcome) (round((increase(appstore_apple_requests_milliseconds_count{job=\"appstore\"}[$__range]) and appstore_apple_requests_milliseconds_count{job=\"appstore\"} offset $__range) or (last_over_time(appstore_apple_requests_milliseconds_count{job=\"appstore\"}[$__range]) unless appstore_apple_requests_milliseconds_count{job=\"appstore\"} offset $__range)))",
          "legendFormat": "{{api}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Apple calls rejected or failed in range",
      "description": "Rate limits (rate_limited, short_circuited, budget_exhausted), open circuit breakers, and failures (connect_error, read_timeout, server_error, contract_error). Alert rules: ops/alerts.yml.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "orientation": "horizontal" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(round((increase(appstore_apple_requests_milliseconds_count{job=\"appstore\", outcome=~\"rate_limited|short_circuited|budget_exhausted\"}[$__range]) and appstore_apple_requests_milliseconds_count offset $__range) or (last_over_time(appstore_apple_requests_milliseconds_count{job=\"appstore\", outcome=~\"rate_limited|short_circuited|budget_exhausted\"}[$__range]) unless appstore_apple_requests_milliseconds_count offset $__range))) or vector(0)",
          "legendFormat": "rate limited",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(round((increase(appstore_apple_requests_milliseconds_count{job=\"appstore\", outcome=\"circuit_open\"}[$__range]) and appstore_apple_requests_milliseconds_count offset $__range) or (last_over_time(appstore_apple_requests_milliseconds_count{job=\"appstore\", outcome=\"circuit_open\"}[$__range]) unless appstore_apple_requests_milliseconds_count offset $__range))) or vector(0)",
          "legendFormat": "circuit open",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(round((increase(appstore_apple_requests_milliseconds_count{job=\"appstore\", outcome=~\"connect_error|read_timeout|server_error|contract_error\"}[$__range]) and appstore_apple_requests_milliseconds_count offset $__range) or (last_over_time(appstore_apple_requests_milliseconds_count{job=\"appstore\", outcome=~\"connect_error|read_timeout|server_error|contract_error\"}[$__range]) unless appstore_apple_requests_milliseconds_count offset $__range))) or vector(0)",
          "legendFormat": "failed",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Apple latency p50 and p95 by API",
      "description": "Duration of logical Apple calls including retries (appstore.apple.requests histogram). The AppleLatencyHigh alert fires above 3 s at p95.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, api) (rate(appstore_apple_requests_milliseconds_bucket{job=\"appstore\"}[$__rate_interval])))",
          "legendFormat": "p95 {{api}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, api) (rate(appstore_apple_requests_milliseconds_bucket{job=\"appstore\"}[$__rate_interval])))",
          "legendFormat": "p50 {{api}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Circuit breaker state",
      "description": "One breaker per Apple API (ADR-0047). Open means uncached requests to that API get 503 without calling Apple.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 }] },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed", "index": 0 }, "1": { "text": "half open", "index": 1 }, "2": { "text": "open", "index": 2 } } }
          ]
        },
        "overrides": []
      },
      "options": { "showValue": "auto", "mergeValues": true, "rowHeight": 0.8, "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (name) (resilience4j_circuitbreaker_state{job=\"appstore\", state=\"half_open\"}) + 2 * max by (name) (resilience4j_circuitbreaker_state{job=\"appstore\", state=~\"open|forced_open\"})",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Caches and storefronts",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Hits divided by all gets per cache (Caffeine statistics, cache.gets).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (cache) (rate(cache_gets_total{job=\"appstore\", result=\"hit\"}[$__rate_interval])) / sum by (cache) (rate(cache_gets_total{job=\"appstore\"}[$__rate_interval]))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Cache hit ratio in range",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 39 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 0.3 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (cache) ((increase(cache_gets_total{job=\"appstore\", result=\"hit\"}[$__range]) and cache_gets_total offset $__range) or (last_over_time(cache_gets_total{job=\"appstore\", result=\"hit\"}[$__range]) unless cache_gets_total offset $__range)) / sum by (cache) ((increase(cache_gets_total{job=\"appstore\"}[$__range]) and cache_gets_total offset $__range) or (last_over_time(cache_gets_total{job=\"appstore\"}[$__range]) unless cache_gets_total offset $__range))",
          "legendFormat": "{{cache}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Storefront allowlist mismatches in range",
      "description": "missing: Apple served a storefront the allowlist lacks (WARN). outdated: Apple rejected a listed storefront (ERROR, StorefrontAllowlistOutdated alert).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 39 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "orientation": "horizontal" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (direction) (round(increase(appstore_storefront_allowlist_mismatch_total{job=\"appstore\"}[$__range])))",
          "legendFormat": "{{direction}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "panels": []
    },
    {
      "id": 15,
      "type": "table",
      "title": "Recent requests (Tempo)",
      "description": "Server traces of service appstore. Select a trace id to open it; the X-Correlation-Id response header carries the same id.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"appstore\" && kind=server}",
          "tableType": "traces",
          "limit": 20
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Log lines by level",
      "description": "Application log records exported over OTLP (ADR-0051), counted by severity. severity_text is Loki structured metadata.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 59 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (severity_text) (count_over_time({service_name=\"appstore\"} [$__auto]))",
          "legendFormat": "{{severity_text}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Application logs",
      "description": "Newest records of service appstore. To see one request's lines, filter in Explore with {service_name=\"appstore\"} | trace_id=\"<trace id>\".",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 67 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none", "prettifyLogMessage": false },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"appstore\"}",
          "queryType": "range",
          "maxLines": 200
        }
      ]
    }
  ]
}
