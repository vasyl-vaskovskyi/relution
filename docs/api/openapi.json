      "AppSearchResponse" : {
        "properties" : {
          "count" : {
            "format" : "int32",
            "type" : "integer"
          },
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/Item"
            },
            "type" : "array"
          },
          "storefront" : {
            "$ref" : "#/components/schemas/SearchStorefront"
          }
        },
        "type" : "object"
      },
      "DetailsStorefront" : {
        "properties" : {
