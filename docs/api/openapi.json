          }
        },
        "type" : "object"
      },
      "Item" : {
        "properties" : {
          "developer" : {
            "type" : "string"
          },
          "iconUrl" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "price" : {
            "$ref" : "#/components/schemas/PriceDto"
          },
          "rating" : {
            "$ref" : "#/components/schemas/RatingDto"
          }
        },
        "type" : "object"
      },
      "Links" : {
