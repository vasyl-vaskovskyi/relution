              "type" : "string"
            },
            "type" : "array"
          },
          "iconUrl" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string"
          },
          "links" : {
            "$ref" : "#/components/schemas/Links"
          },
          "minimumOsVersion" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "platforms" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "price" : {
            "$ref" : "#/components/schemas/PriceDto"
          },
          "rating" : {
