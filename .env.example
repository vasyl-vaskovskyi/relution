# Copy to .env (git-ignored) and fill in the required values: cp .env.example .env
# Names, defaults and descriptions: docs/operations/configuration.md
# Compose passes every line to the app container. Never commit .env.

# --- Required ---------------------------------------------------------------
# The app refuses to start without them.
# The commented value under each variable is for LOCAL TESTING only: it is public, so never use it on a shared or
# deployed instance. Uncomment it to use it; the later line overrides the empty one (compose and "source .env").

# HS256 signing key, Base64, at least 32 bytes after decoding. Generate: openssl rand -base64 32
APPSTORE_AUTH_JWT_SECRET=
#APPSTORE_AUTH_JWT_SECRET=bG9jYWwtdGVzdGluZy1vbmx5LW5ldmVyLXVzZS1pbi1wcm9kIQ==
# Client id for POST /auth/token and the web client login
APPSTORE_AUTH_CLIENT_ID=
#APPSTORE_AUTH_CLIENT_ID=local-test-client
# Client secret for POST /auth/token and the web client login. Generate: openssl rand -base64 32
APPSTORE_AUTH_CLIENT_SECRET=
#APPSTORE_AUTH_CLIENT_SECRET=local-test-secret-change-me

# --- Optional ---------------------------------------------------------------
# Uncomment to override the default shown.

# Access-token lifetime (maximum PT1H)
#APPSTORE_AUTH_JWT_TTL=PT15M
# JWT iss
#APPSTORE_AUTH_JWT_ISSUER=appstore
# JWT aud
#APPSTORE_AUTH_JWT_AUDIENCE=appstore-api
# Search API base URL
#APPSTORE_APPLE_SEARCH_URL=https://itunes.apple.com
# Lookup API base URL
#APPSTORE_APPLE_LOOKUP_URL=https://uclient-api.itunes.apple.com
# Connect timeout
#APPSTORE_APPLE_TIMEOUT_CONNECT=PT2S
# Read timeout
#APPSTORE_APPLE_TIMEOUT_READ=PT5S
# Retries for connection failures
#APPSTORE_APPLE_RETRY_MAX=2
# No new attempt starts after this time
#APPSTORE_APPLE_RETRY_TIMEOUT=PT8S
# Upper bound for Apple's Retry-After in the 429 guard
#APPSTORE_APPLE_RETRYAFTER_MAX=PT5M
# Outbound Search calls per minute
#APPSTORE_APPLE_SEARCH_BUDGET=20
# app-search time to live and maximum entries
#APPSTORE_CACHE_SEARCH_TTL=PT10M
#APPSTORE_CACHE_SEARCH_SIZE=1000
# app-details time to live (found apps) and maximum entries
#APPSTORE_CACHE_DETAILS_TTL=PT15M
#APPSTORE_CACHE_DETAILS_SIZE=5000
# app-details time to live for unknown app ids
#APPSTORE_CACHE_NOTFOUND_TTL=PT60S
# prod disables the API docs
#SPRING_PROFILES_ACTIVE=prod

# --- Observability stack only (compose.observability.yml) -------------------

# Grafana admin password. Generate: openssl rand -base64 32
#APPSTORE_GRAFANA_ADMIN_PASSWORD=
